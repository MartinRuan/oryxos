# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text files with LF
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.properties text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.imports text eol=lf

# Binary files
*.jar binary
*.db binary
